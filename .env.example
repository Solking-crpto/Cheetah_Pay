# CheetahPay — environment variable reference
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Network ────────────────────────────────────────────────────────────────────
# "mainnet" = Arc Mainnet (chain 5042, real funds, requires independent audit)
# Any other value (or absent) = Arc Testnet (chain 5042002, safe for development)
VITE_NETWORK=testnet

# ── Contract addresses ─────────────────────────────────────────────────────────
# Testnet: set by Arc Studio at deploy time.
VITE_PAYMENT_ROUTER_ADDRESS=

# Mainnet: set this after your own verified mainnet deployment.
# Leave blank unless VITE_NETWORK=mainnet.
VITE_MAINNET_ROUTER_ADDRESS=

# ── Fiat sandbox backend (testnet only) ────────────────────────────────────────
# Required to start the backend server (bun run server).
# The backend is only used for the sandbox card payment option.
# These values are NEVER read by the frontend — no VITE_ prefix.

# Secret used to sign and verify sandbox webhook payloads.
# Generate with: openssl rand -hex 32
FIAT_WEBHOOK_SECRET=

# Private key of an Arc Testnet wallet funded with test USDC.
# Used by the treasury to settle sandbox fiat payments on-chain.
# NEVER use a mainnet key here.
TREASURY_PRIVATE_KEY=

# ── Arc Studio RPC proxy (set automatically by Arc Studio) ─────────────────────
# These are provisioned by Arc Studio and should not be set manually.
# Outside Arc Studio they are absent; the backend falls back to public RPC.
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=
